APP_NAME="Vigilus Guinée"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Conakry

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack

MAIL_MAILER=log
MAIL_FROM_ADDRESS=contact@example.invalid
MAIL_FROM_NAME="${APP_NAME}"

SITE_COUNTRY=GN
SITE_CURRENCY=GNF
SITE_CITY=Conakry
SITE_PHONE=
SITE_ADDRESS=
SITE_EMAIL=
SITE_WHATSAPP=

# Le seeder crée l'administrateur UNIQUEMENT si les deux variables sont remplies.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Alertes nouvelles commandes : adresse commerciale vérifiée (optionnel).
ORDER_ALERT_EMAIL=

# Préproduction : false. À activer seulement après validation du domaine,
# des contenus, redirections et accès Search Console.
SEO_INDEXING_ENABLED=false
# Domaines historiques autorisés après inventaire vérifié (séparés par virgule).
# Ne pas autoriser des domaines Côte d'Ivoire pour une boutique Guinée.
SEO_APPROVED_LEGACY_HOSTS=

# Boîte commerciale de réception des demandes de devis, distincte du BOQ.
QUOTE_ALERT_EMAIL=
